<UserControl x:Class="SmartPOS.UI.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="32">
        <Border Background="{DynamicResource CardBrush}" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="32">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource Dashboard}" Style="{DynamicResource BaseText}"
                           FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Margin="0,12,0,0" FontSize="14" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Smart POS ERP — Modular navigation ready" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
