<Window x:Class="SmartPOS.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}"
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FlowDirection="LeftToRight">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="16,12">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="{DynamicResource AppTitle}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Theme}" Style="{DynamicResource PrimaryButton}"
                            Margin="0,0,8,0" Command="{Binding ToggleThemeCommand}" />
                    <Button Content="{DynamicResource Language}" Style="{DynamicResource PrimaryButton}"
                            Command="{Binding ToggleLanguageCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="32">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource FoundationReady}" Style="{DynamicResource BaseText}"
                               FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,12,0,0" FontSize="14" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Smart POS ERP — Sprint 1 (Foundation)" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="16,8">
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                       Text="Sprint 1 — Foundation • .NET 8 • WPF • MVVM • Clean Architecture" />
        </Border>
    </Grid>
</Window>
