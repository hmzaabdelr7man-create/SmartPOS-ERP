{
  "Database": {
    "Provider": "Sqlite",
    "SqliteConnectionString": "Data Source=smartpos.db",
    "PostgreSqlConnectionString": "Host=localhost;Database=smartpos;Username=postgres;Password=postgres",
    "AutoMigrate": true,
    "LogSql": false
  },
  "Theme": {
    "Current": "Light",
    "FollowSystem": false
  },
  "Language": {
    "Current": "Arabic"
  },
  "Company": {
    "Name": "Smart POS ERP",
    "TaxNumber": "",
    "Address": "",
    "Phone": "",
    "Email": "",
    "Website": "",
    "ReceiptFooter": "Thank you for your business!"
  },
  "Printer": {
    "ReceiptPrinterName": "",
    "ReportPrinterName": "",
    "ReceiptPaperSize": "Receipt80mm",
    "ReceiptCopies": 1,
    "ShowPrintDialog": false,
    "ShowPreview": true
  },
  "Backup": {
    "DestinationFolder": "Backups",
    "BackupOnExit": false,
    "MaxRetainedFiles": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/smartpos-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
